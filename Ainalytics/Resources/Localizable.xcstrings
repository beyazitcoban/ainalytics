    "Approve Ainalytics in System Settings → General → Login Items.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genehmige Ainalytics in den Systemeinstellungen → Allgemein → Anmeldeobjekte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprueba Ainalytics en Ajustes del Sistema → General → Ítems de inicio de sesión."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainalytics'i Sistem Ayarları → Genel → Giriş Öğeleri'nde onayla."
          }
        }
      }
    },
