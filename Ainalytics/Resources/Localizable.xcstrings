    "Estimated cost if this usage were billed via each provider's API — not your subscription price.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschätzte Kosten, wenn diese Nutzung über die API jedes Anbieters abgerechnet würde — nicht dein Abopreis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coste estimado si este uso se facturara mediante la API de cada proveedor — no el precio de tu suscripción."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kullanım her sağlayıcının API'si üzerinden faturalansaydı tahmini maliyet — abonelik ücretiniz değil."
