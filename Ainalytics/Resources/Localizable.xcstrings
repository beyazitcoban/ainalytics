    "Get notified once when usage crosses a threshold, and again when it resets.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte eine Benachrichtigung, wenn die Nutzung einen Schwellenwert überschreitet, und erneut, wenn sie zurückgesetzt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe una notificación cuando el uso cruza un umbral y otra cuando se restablece."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanım bir eşiği aştığında ve sıfırlandığında bir kez bildirim al."
          }
