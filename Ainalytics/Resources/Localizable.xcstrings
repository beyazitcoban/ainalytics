          "stringUnit": {
            "state": "translated",
            "value": "Die tägliche Nutzung erscheint hier, sobald sich Snapshots ansammeln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El uso diario aparecerá aquí a medida que se acumulen las instantáneas."
