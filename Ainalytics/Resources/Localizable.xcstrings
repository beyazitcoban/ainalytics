    },
    "Based on your busiest window in the last 14 days.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Basierend auf deinem stärksten Fenster der letzten 14 Tage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Según tu ventana de mayor uso en los últimos 14 días."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son 14 gündeki en yoğun pencerene göre."
          }
        }
