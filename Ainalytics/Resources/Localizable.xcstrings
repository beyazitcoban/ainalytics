{
  "sourceLanguage": "en",
  "strings": {
    "%1$@ is %2$@ used.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist zu %2$@ ausgelastet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está al %2$@ de uso."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ kullanıldı."
          }
        }
      }
    },
    "%@ left": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ übrig"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ restante"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kaldı"
          }
        }
      }
    },
    "%lld-day streak": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld-Tage-Serie"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Racha de %lld días"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld günlük seri"
          }
        }
      }
    },
    "A disabled provider isn't fetched and is hidden from the menu bar and dashboard.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein deaktivierter Anbieter wird nicht abgefragt und ist in der Menüleiste und im Dashboard ausgeblendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un proveedor desactivado no se consulta y se oculta de la barra de menús y del panel."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devre dışı bırakılan sağlayıcı sorgulanmaz; menü çubuğu ve panoda gizlenir."
          }
        }
      }
    },
    "API-equivalent cost": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-äquivalente Kosten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coste equivalente de API"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "API eşdeğeri maliyet"
          }
        }
      }
    },
    "API-equivalent, monthly-normalized — vs your subscription price. An estimate, not a bill.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-äquivalent, auf den Monat normiert – im Vergleich zu deinem Abopreis. Eine Schätzung, keine Rechnung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Equivalente a API, normalizado por mes, frente al precio de tu suscripción. Una estimación, no una factura."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "API-eşdeğeri, aya normalize — abonelik fiyatınla kıyaslanır. Tahmindir, fatura değil."
          }
        }
      }
    },
    "Activity": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivität"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actividad"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivite"
          }
        }
      }
    },
    "Activity appears here once your Claude or Codex CLI has session logs.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivität erscheint hier, sobald deine Claude- oder Codex-CLI Sitzungslogs hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actividad aparecerá aquí cuando tu CLI de Claude o Codex tenga registros de sesión."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude veya Codex CLI'nizin oturum logları olduğunda aktivite burada görünür."
          }
        }
      }
    },
